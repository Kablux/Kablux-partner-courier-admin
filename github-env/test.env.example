# GitHub Environment: test (branch test → staging-courier-partner.kabluxe.com)
# Set with:
#   gh secret set SSH_HOST --env test --repo Kablux/Kablux-partner-courier-admin
#   gh secret set SSH_USER --env test --repo Kablux/Kablux-partner-courier-admin
#   gh secret set SSH_PRIVATE_KEY --env test --repo Kablux/Kablux-partner-courier-admin < deploy-test.pem
#   gh secret set VITE_API_BASE_URL --env test --repo Kablux/Kablux-partner-courier-admin
#
# Reuse the same SSH_HOST / SSH_USER / SSH_PRIVATE_KEY as Supa-admin-dashboard environment "test"
# (same API droplet nginx serves both SPAs).

SSH_HOST=
SSH_USER=
SSH_PRIVATE_KEY=
VITE_API_BASE_URL=https://staging-api-courier.kabluxe.com/api/v1