# GitHub Environment: Production (branch main → courier-partner.kabluxe.com)
# Set with:
#   gh secret set SSH_HOST --env Production --repo Kablux/Kablux-partner-courier-admin
#   gh secret set SSH_USER --env Production --repo Kablux/Kablux-partner-courier-admin
#   gh secret set SSH_PRIVATE_KEY --env Production --repo Kablux/Kablux-partner-courier-admin < deploy-prod.pem
#   gh secret set VITE_API_BASE_URL --env Production --repo Kablux/Kablux-partner-courier-admin
#
# Reuse the same SSH_* secrets as Supa-admin-dashboard environment "production".

SSH_HOST=
SSH_USER=
SSH_PRIVATE_KEY=
VITE_API_BASE_URL=https://courier-api.kabluxe.com/api/v1